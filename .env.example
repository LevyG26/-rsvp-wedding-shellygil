# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or real Firebase/admin credentials.

# VITE_ values are public after build because they are bundled into the browser app.
# Keep real secrets, private keys, and service-account JSON out of VITE_ variables.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_SENDER_ID"
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional. Leave empty when using the default Firestore database.
VITE_FIRESTORE_DATABASE_ID=""

# Admin sign-in now uses real Firebase Authentication (Email/Password), not an
# env-var gate. Create your admin account in Firebase Console > Authentication
# > Users, then paste its UID into the isAdmin() allowlist in firestore.rules.
# There is nothing to set here for admin login anymore.

# Public event details. These are visible in the built website.
VITE_EVENT_START_ISO="2027-01-01T17:00:00"
VITE_EVENT_CALENDAR_START="20270101T170000"
VITE_EVENT_CALENDAR_END="20270101T220000"
VITE_EVENT_TIME_ZONE="Asia/Jerusalem"

# Server-only values for npm run sync:base-list -- --write.
# These are read by the local sync script and must not be exposed to the browser.
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIRESTORE_DATABASE_ID=""
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
FIRESTORE_DATABASE_ID=""

# Sensitive admin SDK credentials. Prefer GOOGLE_APPLICATION_CREDENTIALS.
# Do not commit real service-account JSON or private key content.
# GOOGLE_APPLICATION_CREDENTIALS="C:\\path\\to\\service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",...}"
