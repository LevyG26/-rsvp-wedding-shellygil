rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    // Admin allowlist: paste in the Firebase Auth UID(s) of the account(s)
    // you created in Authentication > Users (Project settings, not a secret -
    // it's just an identifier). Add a comma-separated entry per admin.
    // Example: return request.auth != null && request.auth.uid in [
    //   'AbCdEf123456...',
    //   'GhIjKl789012...'
    // ];
    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'dE3U6LujIjhUrv2jJkzFE2wRwfA3'
      ];
    }

    // Second-tier login for people helping run seating on the day of the
    // event - far more limited than isAdmin() above. Granted read-only
    // access to the guest roster (so they can check whether a surprise
    // walk-in actually confirmed) and full read/write on the seating-related
    // collections only - never rsvps, giftEntries, baseList, or
    // adminNotificationTokens. Empty by default (no staff access at all)
    // until Gil creates the login and this list is filled in - keep this in
    // sync with EVENT_STAFF_UIDS in src/admin/roles.ts, which is what
    // decides what the dashboard UI shows (this is what actually enforces
    // it server-side).
    function isEventStaff() {
      return request.auth != null && request.auth.uid in [
        'XoVitjJbfpeSgdFEeTO9x5mpprx2'
      ];
    }

    function canManageSeating() {
      return isAdmin() || isEventStaff();
    }

    // Structural floor-plan edits (creating/moving/resizing/deleting tables
    // or venue objects, and locking/unlocking the layout) are admin-only -
    // event-day staff can still READ everything via canManageSeating() above
    // (they need to render the floor plan and see who's seated where), and
    // can still write to seatingAssignments/seatingGroups/seatingAlerts (so
    // they can seat a walk-in or dismiss an alert), just not touch the
    // tables/objects themselves.
    function canEditSeatingLayout() {
      return isAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLinkedPhone(phone) {
      return phone is string &&
             phone.size() >= 7 &&
             phone.size() <= 20 &&
             phone.matches('^[0-9]{7,20}$');
    }

    function incoming() { return request.resource.data; }

    function isValidGuestSnapshotField(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function isValidRSVP(data) {
      return data.keys().hasAll(['fullName', 'isAttending', 'guestsCount', 'createdAt']) &&
             (data.keys().size() == 4 || data.keys().size() == 5 || data.keys().size() == 6 || data.keys().size() == 7) &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.isAttending is bool &&
             data.guestsCount is int && data.guestsCount >= 1 && data.guestsCount <= 10 &&
             data.createdAt == request.time &&
             (!('lang' in data) || (data.lang is string && data.lang.size() <= 10)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20 && data.phone.matches('^[0-9+()\\-\\s]{7,20}$')));
    }

    // Lets a guest who already submitted come back to the same link (their
    // browser remembers the RSVP doc id - see src/utils/rsvpSubmission.ts)
    // and correct their own answer in place, instead of creating a second,
    // duplicate rsvps document. Deliberately only allows the exact fields
    // the public RSVP form itself controls (fullName/isAttending/
    // guestsCount/phone/lang) - createdAt must stay exactly what it already
    // was (proves this is an edit, not a disguised new submission), and
    // 'group'/'manualRosterEntryIds' (admin-only fields, set later from the
    // dashboard) can never appear in the diff, so a guest editing their own
    // headcount can never silently wipe out an admin's group assignment or
    // roster link.
    function isValidGuestRsvpSelfUpdate(data, oldData) {
      return data.diff(oldData).affectedKeys().hasOnly(['fullName', 'isAttending', 'guestsCount', 'phone', 'lang', 'note', 'attendanceSetByAdmin']) &&
             data.createdAt == oldData.createdAt &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.isAttending is bool &&
             data.guestsCount is int && data.guestsCount >= 1 && data.guestsCount <= 10 &&
             (!('lang' in data) || (data.lang is string && data.lang.size() <= 10)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20 && data.phone.matches('^[0-9+()\\-\\s]{7,20}$'))) &&
             // A guest submitting their own answer is by definition NOT an
             // admin override - if this field was true from an earlier admin
             // correction, the guest's own fresh edit clears it back to
             // false, since the status shown now genuinely is the guest's
             // own current input again.
             (!('attendanceSetByAdmin' in data) || data.attendanceSetByAdmin == false);
    }

    match /rsvps/{rsvpId} {
      // Only signed-in admins (see isAdmin() above) can read the guest list -
      // this is what actually protects guest privacy, independent of the
      // admin login screen in the app.
      allow read: if isAdmin();
      // Anyone can submit an RSVP - this must stay public for guests.
      allow create: if isValidId(rsvpId) && isValidRSVP(incoming());
      // Dashboard updates (group assignment, guest count, full-name typo
      // fixes, manual roster-match overrides, correcting a guest's
      // attending/not-attending status on their behalf - e.g. a guest calls
      // Gil to say they can no longer make it) are admin-only. fullName,
      // manualRosterEntryIds, and isAttending were each added later than
      // group/guestsCount - all needed adding here too, since a field the
      // dashboard writes but this list doesn't allow gets silently rejected
      // by Firestore (this is exactly what made the dashboard's attendance
      // toggle look like it "reverted" instead of saving, before
      // isAttending was added here). A guest editing their OWN previous
      // submission (see isValidGuestRsvpSelfUpdate above) is the one
      // non-admin path allowed here.
      allow update: if (isAdmin() &&
                       incoming().diff(resource.data).affectedKeys().hasOnly(['group', 'guestsCount', 'fullName', 'manualRosterEntryIds', 'isAttending', 'attendanceSetByAdmin']) &&
                       (!incoming().diff(resource.data).affectedKeys().hasAny(['group']) ||
                         (incoming().group is string && incoming().group.size() <= 60)) &&
                       (!incoming().diff(resource.data).affectedKeys().hasAny(['guestsCount']) ||
                         (incoming().guestsCount is int &&
                           incoming().guestsCount >= 1 &&
                           incoming().guestsCount <= 10)) &&
                       (!incoming().diff(resource.data).affectedKeys().hasAny(['fullName']) ||
                         (incoming().fullName is string && incoming().fullName.size() > 0 && incoming().fullName.size() <= 100)) &&
                       (!incoming().diff(resource.data).affectedKeys().hasAny(['manualRosterEntryIds']) ||
                         (incoming().manualRosterEntryIds is list && incoming().manualRosterEntryIds.size() <= 10)) &&
                       (!incoming().diff(resource.data).affectedKeys().hasAny(['isAttending']) ||
                         incoming().isAttending is bool) &&
                       // Set to true whenever an admin changes isAttending on
                       // a guest's behalf (from either the Responses tab's
                       // own toggle or a status change in the guest roster
                       // tab that syncs back to this document) - a marker so
                       // the Responses tab can show "changed by Gil" instead
                       // of implying the guest updated it themselves.
                       (!incoming().diff(resource.data).affectedKeys().hasAny(['attendanceSetByAdmin']) ||
                         incoming().attendanceSetByAdmin is bool)) ||
                       (isValidId(rsvpId) && isValidGuestRsvpSelfUpdate(incoming(), resource.data));
      // Deletes are admin-only.
      allow delete: if isAdmin();
    }

    function isValidInviteLinkVisit(data, phoneId) {
      return data.keys().hasAll(['phone', 'lang', 'openedAt']) &&
             data.keys().hasOnly(['phone', 'lang', 'openedAt', 'guestName', 'guestGroup']) &&
             data.phone == phoneId &&
             isValidLinkedPhone(data.phone) &&
             data.lang is string &&
             data.lang.size() <= 10 &&
             data.openedAt == request.time &&
             (!('guestName' in data) || isValidGuestSnapshotField(data.guestName)) &&
             (!('guestGroup' in data) || isValidGuestSnapshotField(data.guestGroup));
    }

    function hasBaseListGuestName(phoneId) {
      return ('name' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.name is string &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.name.size() > 0) ||
             ('Name' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.Name is string &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.Name.size() > 0);
    }

    function matchesBaseListGuestName(data, phoneId) {
      return ('name' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
              data.guestName == get(/databases/$(database)/documents/baseList/$(phoneId)).data.name) ||
             ('Name' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
              data.guestName == get(/databases/$(database)/documents/baseList/$(phoneId)).data.Name);
    }

    function hasBaseListGuestGroup(phoneId) {
      return ('group' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.group is string &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.group.size() > 0) ||
             ('Group' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.Group is string &&
              get(/databases/$(database)/documents/baseList/$(phoneId)).data.Group.size() > 0);
    }

    function matchesBaseListGuestGroup(data, phoneId) {
      return 'guestGroup' in data &&
             (('group' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
               data.guestGroup == get(/databases/$(database)/documents/baseList/$(phoneId)).data.group) ||
              ('Group' in get(/databases/$(database)/documents/baseList/$(phoneId)).data &&
               data.guestGroup == get(/databases/$(database)/documents/baseList/$(phoneId)).data.Group));
    }

    function matchesBaseListGuestSnapshot(data, phoneId) {
      return exists(/databases/$(database)/documents/baseList/$(phoneId)) &&
             hasBaseListGuestName(phoneId) &&
             matchesBaseListGuestName(data, phoneId) &&
             ((hasBaseListGuestGroup(phoneId) && matchesBaseListGuestGroup(data, phoneId)) ||
              (!hasBaseListGuestGroup(phoneId) && !('guestGroup' in data)));
    }

    function isValidInviteLinkVisitGuestSnapshotUpdate(data, oldData, phoneId) {
      return data.diff(oldData).affectedKeys().hasOnly(['guestName', 'guestGroup']) &&
             data.keys().hasAll(['phone', 'lang', 'openedAt', 'guestName']) &&
             data.keys().hasOnly(['phone', 'lang', 'openedAt', 'guestName', 'guestGroup']) &&
             data.phone == oldData.phone &&
             data.phone == phoneId &&
             data.lang == oldData.lang &&
             data.openedAt == oldData.openedAt &&
             isValidLinkedPhone(data.phone) &&
             isValidGuestSnapshotField(data.guestName) &&
             (!('guestGroup' in data) || isValidGuestSnapshotField(data.guestGroup)) &&
             matchesBaseListGuestSnapshot(data, phoneId);
    }

    match /inviteLinkVisits/{phoneId} {
      // Only admins can list who opened their invite link (contains guest names/phones).
      allow read: if isAdmin();
      // Recording that a guest opened their personal invite link must stay public
      // (it happens before the guest is authenticated in any way).
      allow create: if isValidId(phoneId) && isValidInviteLinkVisit(incoming(), phoneId);
      allow update: if isValidId(phoneId) &&
                    (isValidInviteLinkVisit(incoming(), phoneId) ||
                     (isAdmin() && isValidInviteLinkVisitGuestSnapshotUpdate(incoming(), resource.data, phoneId)));
      allow delete: if isAdmin() && isValidId(phoneId) && isValidLinkedPhone(phoneId);
    }

    function isValidBaseListEntry(data, phoneId) {
      return data.keys().hasAll(['phone', 'name', 'group']) &&
             data.keys().hasOnly(['phone', 'name', 'group']) &&
             data.phone == phoneId &&
             isValidLinkedPhone(data.phone) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.group is string && data.group.size() <= 120;
    }

    match /baseList/{phoneId} {
      // Public get-by-known-phone-id lookup (used to enrich an invite link
      // visit / RSVP with the guest's name from the base list) stays as-is.
      allow get: if isValidLinkedPhone(phoneId);
      // Admin-only listing of the whole collection - needed for the
      // dashboard's WhatsApp reminders tab, which needs every guest's phone
      // number to build a personalized "click to send" link for each one.
      allow list: if isAdmin();
      // Admin-only create/update - lets the dashboard's "sync phone list
      // from sheet" button (mirrors the existing guest-roster sheet sync)
      // upsert entries directly from the browser, instead of requiring the
      // local Admin-SDK script (scripts/syncBaseList.ts) that only runs from
      // a developer's terminal - not something Gil can do himself.
      allow create, update: if isAdmin() && isValidLinkedPhone(phoneId) && isValidBaseListEntry(incoming(), phoneId);
      allow delete: if false;
    }

    // Full invite roster (side/category/name/count/known response), imported
    // from the couple's master guest-list spreadsheet and/or maintained
    // directly in the dashboard. Contains guest PII, so it's admin-only
    // for both reads and writes.
    function isValidGuestRosterEntry(data) {
      return data.keys().hasAll(['side', 'category', 'firstName', 'lastName', 'invitedCount', 'knownResponse', 'updatedAt', 'linkedFromRsvp', 'preLinkInvitedCount', 'checkedIn', 'checkedInAt']) &&
             data.keys().hasOnly(['side', 'category', 'firstName', 'lastName', 'invitedCount', 'knownResponse', 'updatedAt', 'linkedFromRsvp', 'preLinkInvitedCount', 'checkedIn', 'checkedInAt']) &&
             data.side is string && data.side.size() <= 60 &&
             data.category is string && data.category.size() <= 60 &&
             data.firstName is string && data.firstName.size() <= 60 &&
             data.lastName is string && data.lastName.size() <= 60 &&
             (data.firstName.size() > 0 || data.lastName.size() > 0) &&
             data.invitedCount is int && data.invitedCount >= 1 && data.invitedCount <= 30 &&
             (data.knownResponse == null || data.knownResponse == 'yes' || data.knownResponse == 'no') &&
             data.updatedAt == request.time &&
             // Tracks whether knownResponse/invitedCount currently came from
             // the automatic RSVP-roster linker (see rsvpRosterLink.ts),
             // so it can be reverted if that RSVP is later deleted, without
             // ever touching entries set by sheet sync or a manual edit.
             data.linkedFromRsvp is bool &&
             (data.preLinkInvitedCount == null ||
               (data.preLinkInvitedCount is int && data.preLinkInvitedCount >= 0 && data.preLinkInvitedCount <= 30)) &&
             // Day-of check-in - carried forward as-is by this full-document
             // validator (NOT pinned to request.time, since an unrelated
             // admin edit like a name fix must be able to re-save this
             // document without disturbing an already-set check-in time).
             // The actual check-in action itself goes through
             // isValidCheckInUpdate() below instead.
             data.checkedIn is bool &&
             (data.checkedInAt == null || data.checkedInAt is timestamp);
    }

    // The narrow write event-day staff (and admins) use to mark a guest's
    // party as arrived/not-arrived from the seating tab's guest lookup
    // panel - deliberately separate from isValidGuestRosterEntry above so
    // staff can be granted this one action without also being trusted with
    // every other roster field (name, category, headcount, RSVP status...).
    function isValidCheckInUpdate() {
      return incoming().diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt']) &&
             incoming().checkedIn is bool &&
             (incoming().checkedInAt == null || incoming().checkedInAt == request.time);
    }

    match /guestRoster/{entryId} {
      // Event-day seating staff can READ the full roster too (so they can
      // check whether a surprise walk-in actually confirmed), but only a
      // full admin can add, edit, or remove entries - the dashboard remains
      // the source of truth for this collection. The one exception is
      // check-in (see isValidCheckInUpdate above), which staff can also set.
      allow read: if isAdmin() || isEventStaff();
      allow create: if isAdmin() && isValidId(entryId) && isValidGuestRosterEntry(incoming());
      allow update: if (isAdmin() && isValidGuestRosterEntry(incoming())) ||
                       ((isAdmin() || isEventStaff()) && isValidCheckInUpdate());
      allow delete: if isAdmin();
    }

    // Cash-gift tracking (the "כספים" tab) - amount actually received, keyed
    // by the guestRoster entry id. One optional amount+currency PER payment
    // method (not a single amount + a single method) since a guest can split
    // their gift across more than one - e.g. 500 ILS in cash and 500 USD by
    // Bit. Kept as its own collection rather than fields on guestRoster
    // itself, because every write to a guestRoster document must supply the
    // entry's full, unrelated shape (see isValidGuestRosterEntry above) and
    // that document gets rewritten wholesale by the sheet sync and the
    // automatic RSVP-roster linker - piggybacking gift data there would risk
    // it being silently overwritten by either of those. The app deletes the
    // document entirely once every amount is cleared (see saveGiftEntry in
    // services/giftEntries.ts).
    function isValidGiftCurrency(value) {
      return value in ['ILS', 'USD', 'EUR'];
    }

    // A currency field is only meaningful alongside its amount - the client
    // never writes one without the other - so both must be present together,
    // or both absent.
    function isValidGiftMethodFields(data, amountKey, currencyKey) {
      return (!(amountKey in data) && !(currencyKey in data)) ||
             (
               (amountKey in data) &&
               data[amountKey] is number && data[amountKey] >= 0 && data[amountKey] <= 1000000 &&
               (!(currencyKey in data) || isValidGiftCurrency(data[currencyKey]))
             );
    }

    function isValidGiftEntry(data) {
      return data.keys().hasOnly([
               'cashAmount', 'cashCurrency',
               'bitPayboxAmount', 'bitPayboxCurrency',
               'checkAmount', 'checkCurrency',
               'updatedAt'
             ]) &&
             data.updatedAt == request.time &&
             isValidGiftMethodFields(data, 'cashAmount', 'cashCurrency') &&
             isValidGiftMethodFields(data, 'bitPayboxAmount', 'bitPayboxCurrency') &&
             isValidGiftMethodFields(data, 'checkAmount', 'checkCurrency');
    }

    match /giftEntries/{rosterEntryId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(rosterEntryId) && isValidGiftEntry(incoming());
      allow delete: if isAdmin();
    }

    // Seating chart: tables Gil defines himself (name + seat count), admin-only
    // like everything else guest-related.
    function isValidSeatingTable(data) {
      return data.keys().hasAll(['name', 'seatCount', 'x', 'y', 'width', 'height', 'shape', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'seatCount', 'x', 'y', 'width', 'height', 'shape', 'rotation', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
             data.seatCount is int && data.seatCount >= 1 && data.seatCount <= 40 &&
             // Free-form floor-plan position/size Gil drags and resizes by
             // hand to match the actual hall layout - generous bounds, not
             // meant to be precisely validated, just kept sane.
             data.x is number && data.x >= -2000 && data.x <= 5000 &&
             data.y is number && data.y >= -2000 && data.y <= 5000 &&
             data.width is number && data.width >= 20 && data.width <= 1000 &&
             data.height is number && data.height >= 20 && data.height <= 1000 &&
             // 'teardrop'/'curved' draw a real petal/scalloped-booth outline
             // (see FreeformTableShape in SeatingFloorPlan.tsx) instead of a
             // plain circle/rounded-rect approximation.
             (data.shape == 'round' || data.shape == 'rect' || data.shape == 'teardrop' || data.shape == 'curved') &&
             // Optional - degrees clockwise the decorative shape is rotated,
             // independent of x/y/width/height. Omitted entirely on tables
             // that were never rotated.
             (!('rotation' in data) || (data.rotation is number && data.rotation >= 0 && data.rotation <= 359)) &&
             data.updatedAt == request.time;
    }

    match /seatingTables/{tableId} {
      allow read: if canManageSeating();
      allow create: if canEditSeatingLayout() && isValidId(tableId) && isValidSeatingTable(incoming());
      allow update: if canEditSeatingLayout() && isValidSeatingTable(incoming());
      allow delete: if canEditSeatingLayout();
    }

    // Ad-hoc named clusters of confirmed guestRoster entry IDs, purely for
    // seating multiple otherwise-unrelated parties together in one action -
    // separate from the roster's own side/category fields.
    function isValidSeatingGroup(data) {
      return data.keys().hasAll(['name', 'memberEntryIds', 'updatedAt']) &&
             data.keys().hasOnly(['name', 'memberEntryIds', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
             data.memberEntryIds is list && data.memberEntryIds.size() <= 50 &&
             data.updatedAt == request.time;
    }

    match /seatingGroups/{groupId} {
      allow read: if canManageSeating();
      allow create: if canManageSeating() && isValidId(groupId) && isValidSeatingGroup(incoming());
      allow update: if canManageSeating() && isValidSeatingGroup(incoming());
      allow delete: if canManageSeating();
    }

    // How many of a given roster entry's confirmed seats sit at a given
    // table - a roster entry can have more than one of these rows (split
    // across multiple tables), which is why this isn't just a field on the
    // roster entry itself.
    function isValidSeatingAssignment(data) {
      return data.keys().hasAll(['rosterEntryId', 'tableId', 'seatsCount', 'updatedAt']) &&
             data.keys().hasOnly(['rosterEntryId', 'tableId', 'seatsCount', 'updatedAt']) &&
             data.rosterEntryId is string && data.rosterEntryId.size() > 0 &&
             data.tableId is string && data.tableId.size() > 0 &&
             data.seatsCount is int && data.seatsCount >= 1 && data.seatsCount <= 30 &&
             data.updatedAt == request.time;
    }

    match /seatingAssignments/{assignmentId} {
      allow read: if canManageSeating();
      allow create: if canManageSeating() && isValidId(assignmentId) && isValidSeatingAssignment(incoming());
      allow update: if canManageSeating() && isValidSeatingAssignment(incoming());
      allow delete: if canManageSeating();
    }

    // Auto-generated the moment a seated guest's confirmed status/headcount
    // no longer matches their seating - either seats freed up automatically
    // (declined, or headcount dropped) or extra seats are now needed
    // (headcount grew past what's assigned) - see
    // syncSeatingAssignmentsWithRoster in services/seating.ts. A snapshot of
    // who/where/how-many/why, so Gil can see what happened even after the
    // roster entry or table involved is gone. Uses a deterministic doc id
    // (entryId + table or "needsMore") rather than a random one specifically
    // so two admin sessions racing to notice the same event collapse into
    // one update instead of two duplicate alerts - that's also why update is
    // allowed here (Gil otherwise dismisses one by deleting it).
    function isValidSeatingAlert(data) {
      return data.keys().hasAll(['guestName', 'category', 'tableName', 'seatsCount', 'reason', 'createdAt']) &&
             data.keys().hasOnly(['guestName', 'category', 'tableName', 'seatsCount', 'reason', 'createdAt']) &&
             data.guestName is string && data.guestName.size() > 0 && data.guestName.size() <= 120 &&
             data.category is string && data.category.size() <= 120 &&
             data.tableName is string && data.tableName.size() > 0 && data.tableName.size() <= 60 &&
             data.seatsCount is int && data.seatsCount >= 1 && data.seatsCount <= 40 &&
             data.reason in ['notConfirmed', 'reducedCount', 'needsMoreSeats'] &&
             data.createdAt == request.time;
    }

    match /seatingAlerts/{alertId} {
      allow read: if canManageSeating();
      allow create: if canManageSeating() && isValidId(alertId) && isValidSeatingAlert(incoming());
      allow update: if canManageSeating() && isValidSeatingAlert(incoming());
      allow delete: if canManageSeating();
    }

    // Whether free-drag repositioning on the floor-plan canvas is frozen -
    // shared by every admin (not a personal per-browser setting), so one
    // person locking it protects the layout for anyone else with the
    // dashboard open too. A single well-known doc id, since there's only
    // ever one floor plan.
    function isValidSeatingSettings(data) {
      return data.keys().hasAll(['layoutLocked', 'updatedAt']) &&
             data.keys().hasOnly(['layoutLocked', 'updatedAt']) &&
             data.layoutLocked is bool &&
             data.updatedAt == request.time;
    }

    match /seatingSettings/{settingsId} {
      allow read: if canManageSeating();
      allow create, update: if canEditSeatingLayout() && isValidId(settingsId) && isValidSeatingSettings(incoming());
      allow delete: if false;
    }

    // Non-seating decor on the floor-plan canvas (stage, bar, entrance, dance
    // floor, or a free-text custom label) - lets Gil actually lay out the
    // hall, not just the dinner tables. Same free-form position/size bounds
    // as seatingTables; no seatCount since these aren't seatable.
    function isValidVenueObject(data) {
      return data.keys().hasAll(['type', 'label', 'x', 'y', 'width', 'height', 'shape', 'updatedAt']) &&
             data.keys().hasOnly(['type', 'label', 'x', 'y', 'width', 'height', 'shape', 'rotation', 'updatedAt']) &&
             data.type in ['stage', 'bar', 'entrance', 'danceFloor', 'custom'] &&
             data.label is string && data.label.size() > 0 && data.label.size() <= 60 &&
             data.x is number && data.x >= -2000 && data.x <= 5000 &&
             data.y is number && data.y >= -2000 && data.y <= 5000 &&
             data.width is number && data.width >= 20 && data.width <= 1000 &&
             data.height is number && data.height >= 20 && data.height <= 1000 &&
             (data.shape == 'round' || data.shape == 'rect') &&
             // Optional - kept in step with seatingTables' rotation field
             // even though the object shape picker never offers 'teardrop'/
             // 'curved' today, so the two stay consistent if that changes.
             (!('rotation' in data) || (data.rotation is number && data.rotation >= 0 && data.rotation <= 359)) &&
             data.updatedAt == request.time;
    }

    match /venueObjects/{objectId} {
      allow read: if canManageSeating();
      allow create: if canEditSeatingLayout() && isValidId(objectId) && isValidVenueObject(incoming());
      allow update: if canEditSeatingLayout() && isValidVenueObject(incoming());
      allow delete: if canEditSeatingLayout();
    }

    // One doc per device that opted in to mobile push notifications for new/
    // updated RSVPs (see the "אפשר התראות בנייד" button in the dashboard
    // header). Holds only the FCM registration token itself - never guest
    // data - so it's admin-only read/write like everything else here, but
    // there's nothing sensitive in the token itself beyond "this is one of
    // Gil's devices". Auto-generated doc ID (not the token) because FCM
    // tokens contain characters isValidId() doesn't allow. The Cloud
    // Function that actually sends the push runs with the Admin SDK, which
    // bypasses these rules entirely - this only governs the dashboard's own
    // reads/writes.
    function isValidNotificationToken(data) {
      return data.keys().hasAll(['token', 'createdAt']) &&
             data.keys().hasOnly(['token', 'createdAt']) &&
             data.token is string && data.token.size() > 0 && data.token.size() <= 400 &&
             data.createdAt == request.time;
    }

    match /adminNotificationTokens/{tokenDocId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(tokenDocId) && isValidNotificationToken(incoming());
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
